# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never expose to the client / never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
FOOTBALL_DATA_API_KEY=
# GOAL API (https://goal-api.com/documentation) — venues, live scorers, league top scorers.
# Bearer key from the dashboard. ~1000 requests/day; we cache season fixtures 6h and live events 2–3 min.
GOAL_API_KEY=
# Optional. Defaults to https://api.goal-api.com/v1
# GOAL_API_URL=https://api.goal-api.com/v1
# Optional England Premier League override (default is the Goal coverage id).
# GOAL_API_PL_LEAGUE_ID=

# Required for GET /api/sync?secret=... (manual sync)
XACTSCORE_SYNC_SECRET=

# Optional. Vercel Cron sends Authorization: Bearer <value> to /api/sync
CRON_SECRET=

# On Vercel Hobby, crons can only run once a day. For match reminders (1–4h lead),
# ping GET /api/reminders?secret=<XACTSCORE_SYNC_SECRET> from a free external cron
# every 15 minutes (cron-job.org, EasyCron, etc).
# Optional: ping GET /api/scorers?secret=<XACTSCORE_SYNC_SECRET> every 10 minutes
# during matchdays so live scorers stay fresh even if nobody has Table open.

# Web Push (npx web-push generate-vapid-keys)
# Paste the Public Key / Private Key values only — no quotes, no spaces, no mailto subject here.
# The public key must decode to a 65-byte uncompressed P-256 point (it usually starts with B).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server copy of the same public key. Set this on Vercel so push still works if the
# NEXT_PUBLIC_ value was baked empty at build time.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@xactscore.app

# Email allowed to publish homepage / website updates (required in production)
XACTSCORE_OWNER_EMAIL=
